# Copy to backend/.env and fill in.

# Folder containing sas_2024/, sas_2025/ and ahs_2024/ (defaults to backend/datasets/raw)
# FARMGAP_RAW_DATA_DIR=C:/path/to/nisr-data
# FARMGAP_LOG_LEVEL=INFO

# AI assistant for the Ask page (any OpenAI-compatible API). Leave the key empty for rule-based answers.
# Google Gemini (free key: https://aistudio.google.com/apikey)
FARMGAP_LLM_API_KEY=
FARMGAP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FARMGAP_LLM_MODEL=gemini-2.5-flash
# Groq (free key: https://console.groq.com/keys)
# FARMGAP_LLM_BASE_URL=https://api.groq.com/openai/v1
# FARMGAP_LLM_MODEL=llama-3.3-70b-versatile
